{
  "Uuid": "d5ebdd6c-5cd9-4904-8769-c317e3d68232",
  "IsCustomNode": false,
  "Description": "AA CWD Model Checker - rules defined in Dynamo -> XLSX report",
  "Name": "AA_ModelChecker_Single",
  "ElementResolver": {
    "ResolutionMap": {
      "DesignScript.Builtin.Dictionary": {
        "Key": "DesignScript.Builtin.Dictionary",
        "Value": "DesignScriptBuiltin.dll"
      }
    }
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "4bb12beb11a349f8b45b36435ba83580",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "6e866bbcf1464127bec12d418a240d49",
          "Name": "",
          "Description": "options",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== GLOBAL OPTIONS =====\noptions = {\n    \"ReportTitle\": \"AAHK CWD Model Checker Rules\",\n    \"Author\": \"Gavin\",\n    \"MissingParameterCountsAsFail\": true,  // HasNoValue: element without the parameter = issue\n    \"FamilyNameLoadableOnly\": false,       // true = Family Name filters skip system families\n    \"ListPhaseElements\": true,             // list every element on the Phase sheet\n    \"ShowDisabledChecks\": true,            // disabled rules shown as SKIPPED\n    \"OpenWhenDone\": true,                  // open the xlsx after export\n    \"MaxIdsInCell\": 3000                   // max IDs in the 'All IDs' cell\n};"
    },
    {
