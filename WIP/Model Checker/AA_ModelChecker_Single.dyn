      "Code": "// ===== Room List =====\n// Enabled is driven by the Boolean toggle on the left\nrule = {\n    \"Heading\":     \"Elements Checker\",\n    \"Section\":     \"Family\",\n    \"Name\":        \"Room List\",\n    \"Description\": \"List the rooms in the model\",\n    \"Type\":        \"Custom\",\n    \"Enabled\":     enabled,\n    \"Required\":    true,\n    \"Mode\":        \"Auto\",\n    \"ElementType\": \"Instance\",\n    \"Categories\":  [\n                  \"OST_Rooms\"\n                 ],\n    \"Filters\":     []\n};"
