      "InputValue": true
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "6615629475fb4582be93c65079106b33",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "6f7ab87c3cc54974bd5ad96af6fb6410",
          "Name": "enabled",
          "Description": "enabled",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "05a65d1105c24675bae87ed8621f4adb",
          "Name": "",
          "Description": "params",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "ea2879731fc74c47bd49f548d5eae422",
          "Name": "",
          "Description": "cats",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "adb08f526b08402dac2099270bfee914",
          "Name": "",
          "Description": "rules",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== CAT Code + Asset / TS Parameters (batch) =====\n// One rule per parameter: elements with an empty / missing parameter are listed as issues\n// Edit the params list to add or remove parameters. Output 'rules' -> All Rules\ndef mkRule(p : string, cats : var[]..[], en : bool)\n{\n    return {\n        \"Heading\":     \"Elements Checker\",\n        \"Section\":     \"Parameter Input\",\n        \"Name\":        p,\n        \"Description\": \"To check whether all elements have \" + p + \" input\",\n        \"Type\":        \"Custom\",\n        \"Enabled\":     en,\n        \"Required\":    false,\n        \"Mode\":        \"Auto\",\n        \"ElementType\": \"Instance\",\n        \"Categories\":  cats,\n        \"Filters\":     [[\"Parameter\", p, \"HasNoValue\", \"\"]]\n    };\n}\n\nparams = [\n    \"CAT Code\", \"NQAA\", \"TS_ASS\", \"TS_ASS_L1\", \"TS_ASS_L2\",\n    \"TS_ASS_L3\", \"TS_ASS_L4\", \"TS_DWN\", \"TS_FDES\", \"TS_FFA\",\n    \"TS_FIN\", \"TS_FLC\", \"TS_ICWO\", \"TS_INS\", \"TS_IWC\",\n    \"TS_LOC\", \"TS_LOC_L1\", \"TS_LOC_L2\", \"TS_LOC_L3\", \"TS_LOC_L4\",\n    \"TS_MFG\", \"TS_MMN\", \"TS_MSN\", \"TS_QTY\", \"TS_SRN\",\n    \"TS_ULF\", \"TS_UOM\", \"TS_WED\"\n];\n\ncats = [\n    \"OST_Casework\", \"OST_Ceilings\", \"OST_Columns\",\n    \"OST_CurtainWallPanels\", \"OST_CurtainWallMullions\", \"OST_Doors\",\n    \"OST_ElectricalEquipment\", \"OST_ElectricalFixtures\", \"OST_Floors\",\n    \"OST_Furniture\", \"OST_GenericModel\", \"OST_LightingFixtures\",\n    \"OST_Mass\", \"OST_MechanicalEquipment\", \"OST_Parking\",\n    \"OST_Parts\", \"OST_Planting\", \"OST_PlumbingFixtures\",\n    \"OST_StairsRailing\", \"OST_Ramps\", \"OST_Roads\",\n    \"OST_Roofs\", \"OST_Site\", \"OST_SpecialityEquipment\",\n    \"OST_Stairs\", \"OST_StructuralColumns\", \"OST_StructConnections\",\n    \"OST_StructuralFoundation\", \"OST_StructuralFraming\", \"OST_Rebar\",\n    \"OST_StructuralStiffener\", \"OST_Topography\", \"OST_Walls\",\n    \"OST_Windows\", \"OST_ShaftOpening\", \"OST_StructuralTruss\",\n    \"OST_DuctTerminal\", \"OST_CableTrayFitting\", \"OST_CableTray\",\n    \"OST_CommunicationDevices\", \"OST_ConduitFitting\", \"OST_ConduitRun\",\n    \"OST_Conduit\", \"OST_DataDevices\", \"OST_DuctAccessory\",\n    \"OST_DuctFitting\", \"OST_DuctInsulations\", \"OST_PlaceHolderDucts\",\n    \"OST_DuctCurves\", \"OST_FireAlarmDevices\", \"OST_FlexDuctCurves\",\n    \"OST_FlexPipeCurves\", \"OST_LightingDevices\", \"OST_PipeAccessory\",\n    \"OST_PipeFitting\", \"OST_PipeInsulations\", \"OST_PlaceHolderPipes\",\n    \"OST_PipeCurves\", \"OST_SecurityDevices\", \"OST_Sprinklers\",\n    \"OST_TelephoneDevices\"\n];\n\nrules = mkRule(params, cats, enabled);"
    },
