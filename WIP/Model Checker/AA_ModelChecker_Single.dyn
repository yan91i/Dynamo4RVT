      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== Warning Count =====\n// Enabled is driven by the Boolean toggle on the left\nrule = {\n    \"Heading\":     \"Housekeeping\",\n    \"Section\":     \"Warning\",\n    \"Name\":        \"Warning Count\",\n    \"Description\": \"Reports all warnings in a Revit model.\",\n    \"Type\":        \"WarningCount\",\n    \"Enabled\":     enabled,\n    \"Required\":    false,\n    \"Mode\":        \"Auto\"\n};"
    },
