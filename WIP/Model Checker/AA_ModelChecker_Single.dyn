      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== Family Name =====\n// Enabled is driven by the Boolean toggle on the left\nrule = {\n    \"Heading\":     \"Elements Checker\",\n    \"Section\":     \"Family\",\n    \"Name\":        \"Family Name\",\n    \"Description\": \"To check whether all family names have started with 'AA-'\",\n    \"Type\":        \"Custom\",\n    \"Enabled\":     enabled,\n    \"Required\":    false,\n    \"Mode\":        \"Auto\",\n    \"ElementType\": \"Instance\",\n    \"Categories\":  [\n                  \"OST_Casework\", \"OST_Ceilings\", \"OST_Columns\",\n                  \"OST_CurtainWallPanels\", \"OST_CurtaSystem\", \"OST_CurtainWallMullions\",\n                  \"OST_Doors\", \"OST_ElectricalEquipment\", \"OST_ElectricalFixtures\",\n                  \"OST_Floors\", \"OST_Furniture\", \"OST_GenericModel\",\n                  \"OST_LightingFixtures\", \"OST_MechanicalEquipment\", \"OST_Parking\",\n                  \"OST_Parts\", \"OST_Planting\", \"OST_PlumbingFixtures\",\n                  \"OST_StairsRailing\", \"OST_Ramps\", \"OST_Roads\",\n                  \"OST_Roofs\", \"OST_Site\", \"OST_SpecialityEquipment\",\n                  \"OST_Stairs\", \"OST_StructuralFramingSystem\", \"OST_StructuralColumns\",\n                  \"OST_StructConnections\", \"OST_StructuralFoundation\", \"OST_StructuralFraming\",\n                  \"OST_Rebar\", \"OST_StructuralStiffener\", \"OST_Topography\",\n                  \"OST_Walls\", \"OST_Windows\"\n                 ],\n    \"Filters\":     [\n                  [\"Family\", \"Name\", \"DoesNotContain\", \"AA-\"]\n                 ]\n};"
    },
