      "HintPath": "D:\\Users\\LI_Y1\\Downloads",
      "InputValue": "D:\\Users\\LI_Y1\\Downloads"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "5df7aed775d843e3b46457d859c27bfd",
      "NodeType": "BooleanInputNode",
      "Inputs": [],
