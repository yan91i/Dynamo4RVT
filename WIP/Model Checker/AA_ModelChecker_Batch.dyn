  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "c827f26bbb55430d9fb8246f62377d1a",
      "NodeType": "CodeBlockNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "5b1ac17c7d1a47569c69363bf6a9b176",
          "Name": "",
          "Description": "options",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== GLOBAL OPTIONS =====\noptions = {\n    \"ReportTitle\": \"AAHK CWD Model Checker Rules\",\n    \"Author\": \"Gavin\",\n    \"MissingParameterCountsAsFail\": true,  // HasNoValue: element without the parameter = issue\n    \"FamilyNameLoadableOnly\": false,       // true = Family Name filters skip system families\n    \"ListPhaseElements\": true,             // list every element on the Phase sheet\n    \"ShowDisabledChecks\": true,            // disabled rules shown as SKIPPED\n    \"OpenWhenDone\": true,                  // open the xlsx after export\n    \"MaxIdsInCell\": 3000,                  // max IDs in the 'All IDs' cell\n    // ---- batch mode only ----\n    \"DetachFromCentral\": true,             // workshared: open detached, central is never touched\n    \"OpenAllWorksets\": true,               // false = faster but elements in closed worksets are skipped\n    \"AuditOnOpen\": false,\n    \"IncludeSubfolders\": false,            // folder input: also search sub folders\n    \"SkipBackupFiles\": true                // skip *.0001.rvt backups\n};"
    },
    {
