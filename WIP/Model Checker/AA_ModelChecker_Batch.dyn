      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== In-Place Families =====\n// Enabled is driven by the Boolean toggle on the left\nrule = {\n    \"Heading\":     \"Elements Checker\",\n    \"Section\":     \"Family\",\n    \"Name\":        \"In-Place Families\",\n    \"Description\": \"Check if any In-Place Families exist in the model.\",\n    \"Type\":        \"Custom\",\n    \"Enabled\":     enabled,\n    \"Required\":    false,\n    \"Mode\":        \"Zero\",\n    \"ElementType\": \"Instance\",\n    \"Categories\":  [],\n    \"Filters\":     [\n                  [\"Family\", \"Is In Place\", \"Equal\", \"True\"]\n                 ]\n};"
    },
