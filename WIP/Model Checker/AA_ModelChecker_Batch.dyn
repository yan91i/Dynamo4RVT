        }
      ],
      "Outputs": [
        {
          "Id": "d57630c3ee424e8f93b3eebaa010b286",
          "Name": "",
          "Description": "files",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "80a68e1fc9464a98b4c2a27e24cac6af",
          "Name": "",
          "Description": "rvt",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== BATCH: RVT FILES =====\n// batch = false -> check the CURRENT model only\n// batch = true  -> open every file below in the BACKGROUND, check, close WITHOUT saving\n//                  one xlsx per file (written to Output Folder, or next to each rvt)\n// Items can be .rvt file paths and/or folder paths (all .rvt in the folder)\n// Use / or \\\\ in paths, e.g. \"D:/Project/Models\"\nfiles = [\n    \"C:/Models/Project_A.rvt\",\n    \"C:/Models/Batch Folder\"\n];\nrvt = batch ? files : null;"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
