{
  "Uuid": "80897b33-7df2-47b7-a0cf-15111349ec0b",
  "IsCustomNode": false,
  "Description": "AA CWD Model Checker - rules defined in Dynamo -> XLSX report",
  "Name": "AA_ModelChecker_Batch",
  "ElementResolver": {
