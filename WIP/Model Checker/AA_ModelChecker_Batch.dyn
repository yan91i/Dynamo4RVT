      "Code": "// ===== Worksets =====\n// Enabled is driven by the Boolean toggle on the left\nrule = {\n    \"Heading\":     \"Housekeeping\",\n    \"Section\":     \"Unpurged Elements and References\",\n    \"Name\":        \"Worksets\",\n    \"Description\": \"Lists all user worksets for a Revit model or reports '*Not Workshared*' if worksharing is not enabled.  Also optionally lists the number of instances in each workset.\",\n    \"Type\":        \"Worksets\",\n    \"Enabled\":     enabled,\n    \"Required\":    false,\n    \"Mode\":        \"Auto\"\n};"
    },
