    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "Id": "a476cddc2bd749788d53127f0cd2493d",
      "NodeType": "CodeBlockNode",
      "Inputs": [
        {
          "Id": "b469cea0869846bfafeb8a35a8b2d6e5",
          "Name": "enabled",
          "Description": "enabled",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "cdce12b2d30d4f728cab08d8116f215a",
          "Name": "",
          "Description": "rule",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// ===== NEW RULE TEMPLATE (copy this node + a Boolean, wire into All Rules) =====\n// Filters: [Source, Property, Condition, Value, Operator(opt \"And\"/\"Or\"), CaseInsensitive(opt)]\n//   Source   : \"Parameter\" | \"Family\" | \"Type\" | \"Category\" | \"Class\"\n//   Condition: HasValue, HasNoValue, Equal, NotEqual, Contains, DoesNotContain,\n//              BeginsWith, DoesNotBeginWith, EndsWith, DoesNotEndWith,\n//              MatchesRegex, DoesNotMatchRegex, GreaterThan, LessThan, ...\n// Categories: \"OST_Walls\" or display name \"Walls\"\n// Mode: \"Auto\" | \"Compliance\" | \"Zero\" | \"Info\"   ElementType: \"Instance\" | \"Type\" | \"Both\"\nrule = {\n    \"Heading\":     \"Elements Checker\",\n    \"Section\":     \"My Section\",\n    \"Name\":        \"My New Check\",\n    \"Description\": \"Describe the check\",\n    \"Type\":        \"Custom\",\n    \"Enabled\":     enabled,\n    \"Required\":    false,\n    \"Mode\":        \"Auto\",\n    \"ElementType\": \"Instance\",\n    \"Categories\":  [\"OST_Doors\", \"OST_Windows\"],\n    \"Filters\":     [\n                  [\"Parameter\", \"Mark\", \"HasNoValue\", \"\"]\n                 ]\n};"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "365a157d444749a48c6472de5e88a697",
